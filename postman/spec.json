{
  "name": "Food Menu API - CRUD Tests",
  "description": "Postman tests for the Restaurant Food Menu REST API (Express + SQLite).",
  "baseUrl": "http://localhost:3001",
  "steps": [
    { "id": "TC01", "name": "Create a valid food item", "method": "POST", "path": "/api/food-items", "status": 201, "saveId": true,
      "body": { "name": "Chicken Karahi", "category": "Main Course", "price": 1450.5, "preparationTime": 35, "isAvailable": true },
      "tests": [ { "name": "response contains generated id and same data", "code": "pm.expect(body.id).to.be.a('number'); pm.expect(body.name).to.eql('Chicken Karahi'); pm.expect(body.price).to.eql(1450.5); pm.expect(body.isAvailable).to.eql(true);" } ] },
    { "id": "TC02", "name": "Create a second item (defaults applied)", "method": "POST", "path": "/api/food-items", "status": 201,
      "body": { "name": "Mango Lassi", "category": "Beverage", "price": 250 },
      "tests": [ { "name": "default preparationTime 10 and isAvailable true", "code": "pm.expect(body.preparationTime).to.eql(10); pm.expect(body.isAvailable).to.eql(true);" } ] },
    { "id": "TC03", "name": "Retrieve all food items", "method": "GET", "path": "/api/food-items", "status": 200,
      "tests": [ { "name": "returns an array with both records", "code": "pm.expect(body).to.be.an('array'); pm.expect(body.length).to.eql(2);" } ] },
    { "id": "TC04", "name": "Retrieve items filtered by category", "method": "GET", "path": "/api/food-items?category=Beverage", "status": 200,
      "tests": [ { "name": "only Beverage items returned", "code": "pm.expect(body.length).to.eql(1); pm.expect(body[0].category).to.eql('Beverage');" } ] },
    { "id": "TC05", "name": "Retrieve a single food item by id", "method": "GET", "path": "/api/food-items/{{id}}", "status": 200,
      "tests": [ { "name": "returns the requested record", "code": "pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('id'))); pm.expect(body.name).to.eql('Chicken Karahi');" } ] },
    { "id": "TC06", "name": "Update price and availability", "method": "PUT", "path": "/api/food-items/{{id}}", "status": 200,
      "body": { "name": "Chicken Karahi", "category": "Main Course", "price": 1600, "preparationTime": 35, "isAvailable": false },
      "tests": [ { "name": "returned data shows the updated values", "code": "pm.expect(body.price).to.eql(1600); pm.expect(body.isAvailable).to.eql(false);" } ] },
    { "id": "TC07", "name": "Confirm update persisted in database", "method": "GET", "path": "/api/food-items/{{id}}", "status": 200,
      "tests": [ { "name": "database holds updated values", "code": "pm.expect(body.price).to.eql(1600); pm.expect(body.isAvailable).to.eql(false);" } ] },
    { "id": "TC08", "name": "Create with required fields missing", "method": "POST", "path": "/api/food-items", "status": 400,
      "body": { "preparationTime": 15 },
      "tests": [ { "name": "error lists name, category and price problems", "code": "pm.expect(body.error).to.eql('Validation failed'); pm.expect(body.details.length).to.be.at.least(3);" } ] },
    { "id": "TC09", "name": "Create with negative price and wrong types", "method": "POST", "path": "/api/food-items", "status": 400,
      "body": { "name": "Bad Item", "category": "Snack", "price": -50, "isAvailable": "yes" },
      "tests": [ { "name": "error mentions category, price and isAvailable", "code": "const t = body.details.join(' '); pm.expect(t).to.include('category'); pm.expect(t).to.include('price'); pm.expect(t).to.include('isAvailable');" } ] },
    { "id": "TC10", "name": "Create with price as text", "method": "POST", "path": "/api/food-items", "status": 400,
      "body": { "name": "Text Price", "category": "Dessert", "price": "free" },
      "tests": [ { "name": "price rejected", "code": "pm.expect(body.details.join(' ')).to.include('price');" } ] },
    { "id": "TC11", "name": "Create with duplicate name (different letter case)", "method": "POST", "path": "/api/food-items", "status": 409,
      "body": { "name": "mango lassi", "category": "Beverage", "price": 300 },
      "tests": [ { "name": "conflict error returned", "code": "pm.expect(body.error).to.eql('Conflict');" } ] },
    { "id": "TC12", "name": "Create with malformed JSON body", "method": "POST", "path": "/api/food-items", "status": 400,
      "raw": "{ \"name\": \"Broken\", ",
      "tests": [ { "name": "malformed JSON error returned", "code": "pm.expect(body.error).to.eql('Malformed JSON');" } ] },
    { "id": "TC13", "name": "Get a nonexistent id", "method": "GET", "path": "/api/food-items/9999", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC14", "name": "Update a nonexistent id", "method": "PUT", "path": "/api/food-items/9999", "status": 404,
      "body": { "name": "Ghost Dish", "category": "Dessert", "price": 100 },
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC15", "name": "Get with a non-numeric id", "method": "GET", "path": "/api/food-items/abc", "status": 400,
      "tests": [ { "name": "Invalid id error returned", "code": "pm.expect(body.error).to.eql('Invalid id');" } ] },
    { "id": "TC16", "name": "Delete an existing food item", "method": "DELETE", "path": "/api/food-items/{{id}}", "status": 200,
      "tests": [ { "name": "confirmation message returned", "code": "pm.expect(body.message).to.include('deleted');" } ] },
    { "id": "TC17", "name": "Confirm deleted record cannot be retrieved", "method": "GET", "path": "/api/food-items/{{id}}", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC18", "name": "Delete the already-deleted record", "method": "DELETE", "path": "/api/food-items/{{id}}", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] }
  ]
}
